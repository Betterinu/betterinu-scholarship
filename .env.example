# Copy to .env.local and fill in. Never commit .env.local.
#
# The CRM's public API. These are read only on the server (no NEXT_PUBLIC_
# prefix) so the key is never sent to the browser.

CRM_BASE_URL=https://admin.betterinu.com

# Must match PUBLIC_API_KEY in the CRM project.
# Generate with:  openssl rand -base64 32
#
# Leave this EMPTY. This file is committed to git — the real value belongs in
# .env.local, which is ignored.
CRM_API_KEY=

# The Meta Pixel loads on the live site only — not in dev, and not on Vercel
# preview deployments — so that testing the apply form never writes fake Leads
# into the dataset the ad set optimises on. Nothing to set in Vercel for this:
# the pixel ID is a constant in src/lib/pixel.ts and Vercel injects the
# environment variable that identifies previews on its own.
#
# Set this to 1 in .env.local to load it locally anyway — for Meta Pixel Helper
# and Events Manager → Test Events. Leave it unset for normal development.
NEXT_PUBLIC_META_PIXEL_DEBUG=
